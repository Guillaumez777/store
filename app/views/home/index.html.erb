<% content_for :title, "Mes tâches — Accueil" %>
<% content_for :body_class, "landing" %>

<section class="landing-hero">
  <div class="landing-hero__inner">
    <p class="landing-hero__eyebrow">Votre espace de travail</p>
    <h1 class="landing-hero__title">Toutes vos tâches,<br><em>au même endroit</em></h1>
    <p class="landing-hero__lead">
      Planifiez, suivez et cochez ce qui compte — une landing claire qui regroupe tout ce que vous avez à faire.
    </p>
  </div>
</section>

<% if authenticated? %>
  <section class="landing-stats" aria-label="Résumé des tâches">
    <div class="landing-stats__inner">
      <article class="stat">
        <span class="stat__value"><%= @pending_todos.size %></span>
        <span class="stat__label">À faire</span>
      </article>
      <article class="stat">
        <span class="stat__value"><%= @completed_todos.size %></span>
        <span class="stat__label">Terminées</span>
      </article>
      <article class="stat">
        <span class="stat__value"><%= @todos.size %></span>
        <span class="stat__label">Total</span>
      </article>
    </div>
  </section>

  <section class="landing-tasks" id="taches">
    <div class="landing-tasks__inner">
      <%= render "todos/form", todo: @todo %>

      <div class="task-groups">
        <div class="task-group">
          <header class="task-group__header">
            <h2 class="task-group__title">
              <span class="task-group__dot task-group__dot--pending"></span>
              À faire
              <span class="task-group__count"><%= @pending_todos.size %></span>
            </h2>
          </header>

          <% if @pending_todos.any? %>
            <ul class="task-list">
              <% @pending_todos.each do |todo| %>
                <%= render "todos/todo", todo: todo %>
              <% end %>
            </ul>
          <% else %>
            <p class="task-group__empty">Rien en attente — profitez-en ou ajoutez une nouvelle tâche.</p>
          <% end %>
        </div>

        <div class="task-group task-group--done">
          <header class="task-group__header">
            <h2 class="task-group__title">
              <span class="task-group__dot task-group__dot--done"></span>
              Terminées
              <span class="task-group__count"><%= @completed_todos.size %></span>
            </h2>
          </header>

          <% if @completed_todos.any? %>
            <ul class="task-list">
              <% @completed_todos.each do |todo| %>
                <%= render "todos/todo", todo: todo %>
              <% end %>
            </ul>
          <% else %>
            <p class="task-group__empty">Les tâches cochées apparaîtront ici.</p>
          <% end %>
        </div>
      </div>
    </div>
  </section>
<% else %>
  <section class="landing-guest">
    <div class="landing-guest__card">
      <h2>Connectez-vous pour voir vos tâches</h2>
      <p>Votre liste personnelle (à faire et terminées) s’affichera ici une fois connecté.</p>
      <%= link_to "Se connecter", new_session_path, class: "btn btn--primary btn--lg" %>
    </div>
  </section>
<% end %>

<footer class="landing-footer">
  <p>Store — organisez votre journée.</p>
</footer>
