<header class="site-header" id="top">
  <div class="site-header__inner">
    <%= link_to root_path, class: "site-header__brand" do %>
      <span class="site-header__logo">✦</span>
      <span>Store</span>
    <% end %>

    <nav class="site-header__nav" aria-label="Navigation principale">
      <% if current_page?(root_path) %>
        <a href="#accueil">Accueil</a>
        <a href="#todos">Todos</a>
        <a href="#produits">Produits</a>
      <% else %>
        <%= link_to "Accueil", root_path %>
        <%= link_to "Todos", root_path(anchor: "todos") %>
        <%= link_to "Produits", root_path(anchor: "produits") %>
      <% end %>
      <% if authenticated? %>
        <%= link_to "Mon compte", account_path %>
      <% end %>
    </nav>

    <div class="site-header__actions">
      <% if authenticated? %>
        <span class="site-header__user"><%= current_user.email_address %></span>
        <%= button_to "Déconnexion", session_path, method: :delete, class: "btn btn--ghost btn--sm" %>
      <% else %>
        <%= link_to "Connexion", new_session_path, class: "btn btn--ghost btn--sm" %>
        <%= link_to "S'inscrire", new_registration_path, class: "btn btn--primary btn--sm" %>
      <% end %>
    </div>
  </div>
</header>
