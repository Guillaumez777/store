<header class="site-header">
  <div class="site-header__inner">
    <%= link_to root_path, class: "site-header__brand" do %>
      <span class="site-header__mark">✦</span>
      <span>Mes tâches</span>
    <% end %>

    <nav class="site-header__nav">
      <% if authenticated? %>
        <span class="site-header__email"><%= current_user.email_address %></span>
        <%= button_to "Déconnexion", session_path, method: :delete, class: "btn btn--ghost btn--sm" %>
      <% else %>
        <%= link_to "Connexion", new_session_path, class: "btn btn--primary btn--sm" %>
      <% end %>
    </nav>
  </div>
</header>
